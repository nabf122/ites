<?xml version="1.0" encoding="UTF-8"?>

<configuration>

	<!--Mybatis 설정 -->
	<settings>
		<!-- 전통적인 데이터베이스 컬럼명 형태인 A_COLUMN을 CamelCase형태의 자바 프로퍼티명 형태인 aColumn으로 
			자동으로 매핑하도록 함 -->
		<setting name="mapUnderscoreToCamelCase" value="true"></setting>
		<setting name="callSettersOnNulls" value="true"/>
		<!-- 파라미터에 Null 값이 있을 경우 에러 처리 -->
		<setting name="jdbcTypeForNull" value="VARCHAR"></setting>
	</settings>
	<!-- Type Aliases 설정 -->
	<typeAliases>
		<typeAlias alias="egovMap"
			type="org.egovframe.rte.psl.dataaccess.util.EgovMap" />
		<typeAlias alias="UserVO"
			type="egovframework.com.ites.user.service.UserVO" />
		<typeAlias alias="EquipmentVO"
			type="egovframework.com.ites.equipment.service.EquipmentVO" />
	</typeAliases>
	
	<mappers>
        <mapper resource="mapper/sql/EquipmentMapper.xml"/>
        <mapper resource="mapper/sql/UserMapper.xml"/>
    </mappers>
    
	<typeHandlers>
		<typeHandler handler="egovframework.com.cmm.util.CLOBHandler" javaType="String" jdbcType="LONGVARCHAR" />
		<typeHandler javaType="java.lang.String" jdbcType="CLOB" handler="org.apache.ibatis.type.ClobTypeHandler"/>
	</typeHandlers>
</configuration>