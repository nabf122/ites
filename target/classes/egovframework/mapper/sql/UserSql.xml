<?xml version="1.0" encoding="UTF-8"?>
<mapper namespace="egovframework.com.ites.user.mapper.UserMapper">

    <select id="selectUserInfo" resultType="egovframework.com.ites.user.service.UserVO">
        SELECT *
          FROM TB_USER
         WHERE ORG_NAME = #{orgName}
           AND USER_NAME = #{userName}
    </select>
</mapper>